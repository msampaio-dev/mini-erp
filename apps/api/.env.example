# Copie para .env e ajuste. O .env nunca vai para o Git.
NODE_ENV=development
PORT=3000
# Postgres do docker-compose (porta 5433 no host)
DATABASE_URL="postgresql://erp:erp@localhost:5433/mini_erp?schema=public"
# Origem do front (Vite) liberada no CORS
WEB_ORIGIN=http://localhost:5180
# Sessão: horas de inatividade até expirar
SESSION_TTL_HOURS=8
# Tentativas de login por IP por minuto
LOGIN_RATE_LIMIT=5
# Loja no cupom (ADR 0020). Opcionais: sem eles o cupom mostra só "Mini-ERP".
STORE_NAME=Mini-ERP
STORE_DOCUMENT=
STORE_ADDRESS=
# O que a balança imprime na etiqueta: WEIGHT (peso em gramas, recomendado) ou PRICE (preço)
SCALE_LABEL_MODE=WEIGHT
# Primeiro administrador, criado por `npm run db:seed` (senha: mínimo 10 caracteres)
SEED_ADMIN_EMAIL=admin@mini-erp.local
SEED_ADMIN_PASSWORD=
