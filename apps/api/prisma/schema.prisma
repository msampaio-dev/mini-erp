// Schema do banco do mini-ERP.
// Convenção: modelos em PascalCase no código, tabelas/colunas em snake_case no banco.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Acesso ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  /// Sempre minúsculo (normalizado pelo contrato Zod antes de chegar aqui).
  email        String   @unique
  /// Hash Argon2id no formato PHC. A senha em texto puro nunca é persistida.
  passwordHash String   @map("password_hash")
  /// Desativar em vez de apagar: vendas e movimentações continuam apontando para o autor.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles          UserRole[]
  sessions       Session[]
  stockMovements StockMovement[]
  salesCreated   Sale[]          @relation("SaleCreatedBy")
  salesCanceled  Sale[]          @relation("SaleCanceledBy")
  cashSessions   CashSession[]   @relation("CashSessionOperator")
  cashClosed     CashSession[]   @relation("CashSessionClosedBy")
  cashMovements  CashMovement[]
  saleReturns    SaleReturn[]

  @@map("users")
}

model Role {
  id          String @id @default(uuid(7)) @db.Uuid
  /// Identificador estável usado no código e no seed (ADMIN, GERENTE...).
  key         String @unique
  name        String
  description String @default("")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  /// "<recurso>:<ação>", espelha PERMISSIONS em @mini-erp/contracts.
  key         String @unique
  description String @default("")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  /// SHA-256 do token do cookie. Se o banco vazar, os hashes não servem para logar.
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Expiração deslizante: renovada enquanto o usuário estiver ativo.
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ip        String?
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Contadores do rate limit (ADR 0014). No banco, e não em memória: com várias instâncias
/// da API, todas enxergam o mesmo contador. Atualizado por um único INSERT ... ON CONFLICT.
model RateLimit {
  /// Ex.: "login:<hash do IP>" (gerado pelo @nestjs/throttler).
  key             String    @id
  hits            Int
  windowExpiresAt DateTime  @map("window_expires_at") @db.Timestamptz
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz

  @@index([windowExpiresAt])
  @@map("rate_limits")
}

// ─── Catálogo ──────────────────────────────────────────────────────────────

enum Unit {
  UN
  CX
  PC
  KG
  L
  M
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id   String @id @default(uuid(7)) @db.Uuid
  /// citext: único sem diferenciar maiúsculas ("Bebidas" = "bebidas").
  name String @unique @db.Citext

  products Product[]

  @@map("categories")
}

model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Código de negócio (ADR 0009). Único, editável; as relações usam o id.
  sku            String        @unique
  name           String
  description    String        @default("")
  unit           Unit
  /// GTIN/EAN opcional. UNIQUE permite vários NULL no Postgres.
  barcode        String?       @unique
  /// Código do produto na balança (ADR 0020): 6 dígitos, lido da etiqueta 2CCCCCCVVVVVD.
  scaleCode      String?       @unique @map("scale_code")
  categoryId     String?       @map("category_id") @db.Uuid
  salePriceCents Int           @map("sale_price_cents")
  /// Até 3 casas decimais (unidades fracionáveis: KG, L, M).
  minStock       Decimal       @default(0) @map("min_stock") @db.Decimal(14, 3)
  /// Arquivar em vez de apagar (ADR 0009): o histórico continua íntegro.
  status         ProductStatus @default(ACTIVE)
  /// Optimistic locking: incrementa a cada alteração.
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  balance   StockBalance?
  saleItems SaleItem[]

  @@index([categoryId])
  @@index([status])
  // Índices trigram: busca parcial ("caneta az") sem varrer a tabela inteira.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}

// ─── Estoque (ADR 0002 / ADR 0010) ─────────────────────────────────────────

enum MovementType {
  ENTRY
  ADJUSTMENT
  REVERSAL
  SALE
  /// Devolução de cliente (ADR 0019): a mercadoria volta ao estoque.
  RETURN
}

/// Livro-razão: append-only. Um trigger no banco bloqueia UPDATE e DELETE.
model StockMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  type           MovementType
  /// Com sinal: positivo entra, negativo sai.
  quantity       Decimal      @db.Decimal(14, 3)
  /// Custo unitário da compra (só em ENTRY).
  unitCostCents  Int?         @map("unit_cost_cents")
  /// Motivo padronizado do ajuste (AVARIA, PERDA, INVENTARIO, OUTRO).
  reason         String?
  note           String       @default("")
  /// Saldo logo após esta movimentação: a coluna "saldo" do kardex.
  balanceAfter   Decimal      @map("balance_after") @db.Decimal(14, 3)
  /// Estorno aponta para a original. UNIQUE: cada movimentação é estornada no máximo uma vez.
  reversalOfId   String?      @unique @map("reversal_of_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  /// Chave de idempotência enviada pelo cliente (único por usuário).
  idempotencyKey String?      @map("idempotency_key") @db.Uuid
  /// Entrada de compra: de quem veio e com qual nota fiscal (ADR 0021).
  supplierId     String?      @map("supplier_id") @db.Uuid
  invoiceNumber  String       @default("") @map("invoice_number")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy  User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy StockMovement? @relation("Reversal")
  saleItem   SaleItem?
  returnItem SaleReturnItem?

  @@unique([createdById, idempotencyKey], map: "stock_movements_idempotency_key")
  @@index([productId, createdAt(sort: Desc)])
  @@index([supplierId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

/// Fornecedor (ADR 0021). Desativar em vez de apagar: as entradas antigas continuam apontando para ele.
model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// CNPJ (14) ou CPF (11), só dígitos. Único quando informado.
  document  String?  @unique
  phone     String   @default("")
  email     String   @default("")
  note      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  entries StockMovement[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_trgm_idx")
  @@map("suppliers")
}

/// Saldo atual por produto: cache consistente do ledger, atualizado na mesma transação.
model StockBalance {
  productId    String   @id @map("product_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  /// Custo médio ponderado por unidade, em centavos (4 casas: frações de centavo).
  avgCostCents Decimal  @default(0) @map("avg_cost_cents") @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_balances")
}

// ─── Vendas (ADR 0011) ─────────────────────────────────────────────────────

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
}

model Sale {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Número legível (Venda nº 1042). Sequence do Postgres: pode ter "buracos", é intencional.
  number         Int           @unique @default(autoincrement())
  status         SaleStatus    @default(COMPLETED)
  subtotalCents  Int           @map("subtotal_cents")
  discountCents  Int           @map("discount_cents")
  totalCents     Int           @map("total_cents")
  /// Soma de sale_payments (conferido por trigger no fim da transação, D45).
  receivedCents  Int           @map("received_cents")
  changeCents    Int           @map("change_cents")
  note           String        @default("")
  createdById    String        @map("created_by_id") @db.Uuid
  idempotencyKey String?       @map("idempotency_key") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  canceledAt     DateTime?     @map("canceled_at") @db.Timestamptz
  canceledById   String?       @map("canceled_by_id") @db.Uuid
  cancelReason   String?       @map("cancel_reason")
  /// Sessão de caixa (D44). Nula só nas vendas anteriores ao controle de caixa.
  cashSessionId  String?       @map("cash_session_id") @db.Uuid

  items         SaleItem[]
  payments      SalePayment[]
  cashMovements CashMovement[]
  returns       SaleReturn[]
  createdBy     User          @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  canceledBy    User?         @relation("SaleCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@unique([createdById, idempotencyKey], map: "sales_idempotency_key")
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([cashSessionId])
  @@map("sales")
}

/// Devolução parcial (ADR 0019). A venda continua COMPLETED; a devolução é um documento à parte,
/// como o estorno no estoque: nada do que já foi registrado é reescrito.
model SaleReturn {
  id             String        @id @default(uuid(7)) @db.Uuid
  number         Int           @unique @default(autoincrement())
  saleId         String        @map("sale_id") @db.Uuid
  reason         String
  /// Como o dinheiro voltou ao cliente. Em dinheiro, sai de uma gaveta aberta (D47).
  refundMethod   PaymentMethod @map("refund_method")
  refundCents    Int           @map("refund_cents")
  /// false = a mercadoria não volta a ser vendável (defeito, vencida): sem entrada no estoque.
  restock        Boolean
  createdById    String        @map("created_by_id") @db.Uuid
  idempotencyKey String?       @map("idempotency_key") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  sale      Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleReturnItem[]

  @@unique([createdById, idempotencyKey], map: "sale_returns_idempotency_key")
  @@index([saleId])
  @@index([createdAt(sort: Desc)])
  @@map("sale_returns")
}

model SaleReturnItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  returnId        String  @map("return_id") @db.Uuid
  saleItemId      String  @map("sale_item_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 3)
  refundCents     Int     @map("refund_cents")
  /// Entrada no estoque (nula quando a mercadoria não volta à venda).
  stockMovementId String? @unique @map("stock_movement_id") @db.Uuid

  saleReturn    SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleItem      SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([returnId, saleItemId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

/// Pagamento dividido (D45): uma linha por forma de pagamento.
model SalePayment {
  id          String        @id @default(uuid(7)) @db.Uuid
  saleId      String        @map("sale_id") @db.Uuid
  method      PaymentMethod
  /// Valor entregue naquele meio. Em dinheiro inclui o troco devolvido.
  amountCents Int           @map("amount_cents")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([saleId, method])
  @@map("sale_payments")
}

model SaleItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  saleId          String  @map("sale_id") @db.Uuid
  /// Ordem da linha no cupom.
  position        Int
  productId       String  @map("product_id") @db.Uuid
  /// Fotografia do produto no momento da venda (D24): renomear depois não altera a venda.
  sku             String
  name            String
  unit            Unit
  quantity        Decimal @db.Decimal(14, 3)
  unitPriceCents  Int     @map("unit_price_cents")
  grossCents      Int     @map("gross_cents")
  discountCents   Int     @map("discount_cents")
  netCents        Int     @map("net_cents")
  /// Fotografia da categoria na venda (ADR 0014): mudar o produto de categoria depois não
  /// "leva junto" o faturamento antigo. Sem FK: a categoria pode ser excluída no futuro, e o
  /// histórico mantém o nome que ela tinha.
  categoryId      String? @map("category_id") @db.Uuid
  categoryName    String? @map("category_name")
  /// Custo médio no instante da baixa (D24): base do relatório de margem.
  unitCostCents   Decimal @map("unit_cost_cents") @db.Decimal(18, 4)
  /// A saída de estoque que esta linha gerou. Vendas aponta para Estoque, nunca o contrário.
  stockMovementId String  @unique @map("stock_movement_id") @db.Uuid

  sale          Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovement StockMovement    @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  returns       SaleReturnItem[]

  @@unique([saleId, productId])
  @@unique([saleId, position])
  @@index([productId])
  @@map("sale_items")
}

// ─── Caixa (ADR 0018) ──────────────────────────────────────────────────────

/// Uma sessão por operador aberta por vez (índice único parcial, na migration).
model CashSession {
  id              String    @id @default(uuid(7)) @db.Uuid
  number          Int       @unique @default(autoincrement())
  operatorId      String    @map("operator_id") @db.Uuid
  openedAt        DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  openingCents    Int       @map("opening_cents")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz
  closedById      String?   @map("closed_by_id") @db.Uuid
  /// Fotografia do fechamento: esperado (soma do livro do caixa), contado e diferença.
  expectedCents   Int?      @map("expected_cents")
  countedCents    Int?      @map("counted_cents")
  differenceCents Int?      @map("difference_cents")
  closingNote     String    @default("") @map("closing_note")

  operator  User           @relation("CashSessionOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  closedBy  User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  movements CashMovement[]
  sales     Sale[]

  @@index([operatorId, openedAt(sort: Desc)])
  @@index([openedAt(sort: Desc)])
  @@map("cash_sessions")
}

enum CashMovementType {
  OPENING
  SUPPLY
  WITHDRAWAL
  SALE
  SALE_CANCEL
  REFUND
}

/// Livro do caixa: append-only, como o de estoque. Esperado = soma de amount_cents da sessão.
model CashMovement {
  id             String           @id @default(uuid(7)) @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  type           CashMovementType
  /// Com sinal: positivo entra na gaveta, negativo sai.
  amountCents    Int              @map("amount_cents")
  note           String           @default("")
  saleId         String?          @map("sale_id") @db.Uuid
  createdById    String           @map("created_by_id") @db.Uuid
  idempotencyKey String?          @map("idempotency_key") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sale      Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([createdById, idempotencyKey], map: "cash_movements_idempotency_key")
  @@index([sessionId, createdAt])
  @@index([saleId])
  @@map("cash_movements")
}
