// Schema do banco do mini-ERP.
// Convenção: modelos em PascalCase no código, tabelas/colunas em snake_case no banco.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Acesso ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  /// Sempre minúsculo (normalizado pelo contrato Zod antes de chegar aqui).
  email        String   @unique
  /// Hash Argon2id no formato PHC. A senha em texto puro nunca é persistida.
  passwordHash String   @map("password_hash")
  /// Desativar em vez de apagar: vendas e movimentações continuam apontando para o autor.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles    UserRole[]
  sessions Session[]

  @@map("users")
}

model Role {
  id          String @id @default(uuid(7)) @db.Uuid
  /// Identificador estável usado no código e no seed (ADMIN, GERENTE...).
  key         String @unique
  name        String
  description String @default("")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  /// "<recurso>:<ação>", espelha PERMISSIONS em @mini-erp/contracts.
  key         String @unique
  description String @default("")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  /// SHA-256 do token do cookie. Se o banco vazar, os hashes não servem para logar.
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Expiração deslizante: renovada enquanto o usuário estiver ativo.
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ip        String?
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Catálogo ──────────────────────────────────────────────────────────────

enum Unit {
  UN
  CX
  PC
  KG
  L
  M
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id   String @id @default(uuid(7)) @db.Uuid
  /// citext: único sem diferenciar maiúsculas ("Bebidas" = "bebidas").
  name String @unique @db.Citext

  products Product[]

  @@map("categories")
}

model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Código de negócio (ADR 0009). Único, editável; as relações usam o id.
  sku            String        @unique
  name           String
  description    String        @default("")
  unit           Unit
  /// GTIN/EAN opcional. UNIQUE permite vários NULL no Postgres.
  barcode        String?       @unique
  categoryId     String?       @map("category_id") @db.Uuid
  salePriceCents Int           @map("sale_price_cents")
  /// Até 3 casas decimais (unidades fracionáveis: KG, L, M).
  minStock       Decimal       @default(0) @map("min_stock") @db.Decimal(14, 3)
  /// Arquivar em vez de apagar (ADR 0009): o histórico continua íntegro.
  status         ProductStatus @default(ACTIVE)
  /// Optimistic locking: incrementa a cada alteração.
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([status])
  // Índices trigram: busca parcial ("caneta az") sem varrer a tabela inteira.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}
