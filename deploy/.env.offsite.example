# Cópia dos backups FORA do servidor (ADR 0014). Copie para deploy/.env.offsite (fora do Git).
# Sem esse arquivo, só o backup local roda.
#
# O rclone lê o "remote" chamado OFFSITE destas variáveis RCLONE_CONFIG_OFFSITE_*.
# Use credenciais com permissão SÓ neste bucket (princípio do menor privilégio).

# Destino: <remote>:<bucket>/<pasta>
OFFSITE_REMOTE=offsite:meu-bucket-de-backup/mini-erp
# Quantos dias manter as cópias remotas (pode ser mais que a retenção local)
OFFSITE_KEEP_DAYS=30

# ─── Exemplo: Backblaze B2 / Amazon S3 / Cloudflare R2 / MinIO (API S3) ───
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# ─── Exemplo: outro servidor via SFTP ───
# RCLONE_CONFIG_OFFSITE_TYPE=sftp
# RCLONE_CONFIG_OFFSITE_HOST=backup.minhaempresa.com.br
# RCLONE_CONFIG_OFFSITE_USER=backup
# RCLONE_CONFIG_OFFSITE_KEY_FILE=/run/secrets/backup_key
