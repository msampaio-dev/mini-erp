# Copie para deploy/.env.prod (fora do Git) e preencha. Ver docs/deploy.md.
# Senhas: use valores longos e URL-safe (só letras, números, - e _), pois entram na DATABASE_URL.
# Gerar:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Endereço público. Com domínio, o Caddy emite o certificado HTTPS sozinho.
SITE_ADDRESS=erp.suaempresa.com.br
PUBLIC_URL=https://erp.suaempresa.com.br
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=mini_erp

# Primeiro administrador (criado só se ainda não existir; troque a senha depois)
SEED_ADMIN_EMAIL=admin@suaempresa.com.br
SEED_ADMIN_PASSWORD=

SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT=5

# Backup: intervalo em segundos (86400 = diário) e quantos manter
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7
